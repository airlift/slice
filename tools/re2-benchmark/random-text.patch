@@ -264,2 +267,58 @@ void Search_Hard_CachedRE2(benchmark::State& state)     { Search(state, HARD, Se

+void SearchHardTail(benchmark::State& state, bool expect_match) {
+  static constexpr absl::string_view kSuffix = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
+  ABSL_CHECK_GE(state.range(0), kSuffix.size());
+  std::string text(state.range(0), 'x');
+  text.replace(text.size() - kSuffix.size(), kSuffix.size(), kSuffix);
+  if (!expect_match)
+    text.back() = '_';
+  SearchCachedDFA(state, HARD, text, Prog::kUnanchored, expect_match);
+  state.SetBytesProcessed(state.iterations() * state.range(0));
+}
+
+void Search_HardTailMatch_CachedDFA(benchmark::State& state) {
+  SearchHardTail(state, true);
+}
+
+void Search_HardTailNoMatch_CachedDFA(benchmark::State& state) {
+  SearchHardTail(state, false);
+}
+const char* SelfLoopSuffixPattern() {
+  static const std::string* const pattern = []() {
+    std::string* pattern = new std::string("[ -~]*");
+    for (int i = 0; i < 20; i++)
+      pattern->append("ABCDEFGHIJKLMNOPQRSTUVWXYZ");
+    pattern->append("$");
+    return pattern;
+  }();
+  return pattern->c_str();
+}
+
+void Search_SelfLoopSuffixNoMatch_CachedDFA(benchmark::State& state) {
+  Search(state, SelfLoopSuffixPattern(), SearchCachedDFA);
+}
+
+const char* StateChangingPattern() {
+  static const std::string* const pattern = []() {
+    std::string* pattern = new std::string("^(?:");
+    for (char letter = 'a'; letter <= 'z'; letter++) {
+      pattern->push_back('[');
+      pattern->push_back(letter);
+      pattern->push_back(letter - 'a' + 'A');
+      pattern->push_back(']');
+    }
+    pattern->append(")*(?:0|11)$");
+    return pattern;
+  }();
+  return pattern->c_str();
+}
+
+void Search_StateChangingNoMatch_CachedDFA(benchmark::State& state) {
+  static constexpr absl::string_view kSequence = "abcdefghijklmnopqrstuvwxyz";
+  std::string text(state.range(0), 'a');
+  for (size_t position = 0; position < text.size(); position++)
+    text[position] = kSequence[position % kSequence.size()];
+  SearchCachedDFA(state, StateChangingPattern(), text, Prog::kAnchored, false);
+  state.SetBytesProcessed(state.iterations() * state.range(0));
+}
